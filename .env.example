# CRM and Lead Capture Integration Webhook
# When configured, lead submissions from the multi-step survey and contact forms
# will be securely dispatched via HTTPS POST. Leave empty for local development logging.
CRM_WEBHOOK_URL=https://api.yourcrm.com/v1/leads/webhook

# Analytics Configuration
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Site URL for canonical metadata and sitemap generation
NEXT_PUBLIC_SITE_URL=https://northstarmortgage.com
